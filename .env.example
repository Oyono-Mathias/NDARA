# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Backblaze B2 Storage
B2_ENDPOINT="https://s3.us-west-004.backblazeb2.com"
B2_KEY_ID=""
B2_APPLICATION_KEY=""
B2_BUCKET_NAME=""
B2_ACCOUNT_ID=""
B2_PUBLIC_DOMAIN="cdn.ndara.io"

# Cloudflare R2 Storage (Light Assets)
R2_ENDPOINT="https://15c62cd65574a8ed96678f914b32a754.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="ndara-bucket"
R2_ACCOUNT_ID=""
R2_PUBLIC_DOMAIN=""

# Bunny Edge Storage (Primary Asset Storage S3 API)
BUNNY_STORAGE_ZONE_NAME="nndara-files"
BUNNY_STORAGE_PASSWORD=""
BUNNY_STORAGE_ENDPOINT="storage.bunnycdn.com"
BUNNY_PULL_ZONE_DOMAIN="vz-758d93f4-d56.b-cdn.net"

# Bunny Stream (Video Pilot Phase)
BUNNY_STREAM_LIBRARY_ID=698776
BUNNY_STREAM_API_KEY=""
BUNNY_STREAM_CDN_HOSTNAME=vz-758d93f4-d56.b-cdn.net
BUNNY_STREAM_SECURITY_KEY=""

# Cloudflare Turnstile (Anti-Bot Phase 5)
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
-e 
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# Firebase Admin (Production Backend Database)
FIREBASE_SERVICE_ACCOUNT='{"type": "service_account", "project_id": "...", ...}'

# Stripe (Card Payments)
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Flutterwave (Mobile Money - MTN/Orange)
FLUTTERWAVE_SECRET_KEY="FLWSECK_..."
FLUTTERWAVE_WEBHOOK_SECRET="my_secure_webhook_hash"

# Payment Gateways Configuration
DEFAULT_PAYMENT_PROVIDER="mesomb"
MESOMB_ENABLED="true"
STRIPE_ENABLED="false"
FLUTTERWAVE_ENABLED="false"

# Mesomb API
MESOMB_APPLICATION_KEY=""
