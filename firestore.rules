rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() { return request.auth != null; }
    function existing() { return resource.data; }
    function incoming() { return request.resource.data; }
    function isAdmin() { 
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Entity validation
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role']) && 
             data.email is string && data.email.size() <= 100 &&
             data.role is string && (data.role == 'user' || data.role == 'instructor' || data.role == 'admin' || data.role == 'agent' || data.role == 'super_admin');
    }

    match /statistiques/{statId} {
      allow read: if true;
    }
    
    match /users/{userId} {
      // Users can read their own profile. Admins can read all. Instructors are public.
      allow read: if (isSignedIn() && (request.auth.uid == userId || isAdmin())) || (existing().role == 'instructor');
      
      // Users can create their own profile, but must default to 'user' role
      allow create: if isSignedIn() && request.auth.uid == userId && 
                       isValidUser(incoming()) && incoming().role == 'user';
      
      // Users can update their own profile, but cannot change their role. Admins can do anything.
      allow update: if isSignedIn() && isValidUser(incoming()) && (
        isAdmin() ||
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['email']))
      );
    }
    
    match /courses/{courseId} {
      // Public can read published courses
      allow read: if (existing().isPublished == true) || (isSignedIn() && request.auth.uid == existing().instructorId) || isAdmin();
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == existing().instructorId);
    }
    
    match /categories/{categoryId} {
      allow read: if true;
    }
    
    match /reviews/{reviewId} {
      allow read: if existing().isApproved == true;
      allow write: if isSignedIn();
    }
    
    match /testimonials/{testimonialId} {
      allow read: if existing().isApproved == true;
      allow write: if isAdmin();
    }
  }
}
