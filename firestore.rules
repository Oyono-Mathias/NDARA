rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function isAdmin() { 
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin'
      ); 
    }
    match /{document=**} {
      allow read, write: if false;
    }

    match /assignments_submissions/{id} {
      allow read, write: if isAuthenticated();
    }

    match /audit_logs/{id} {
      allow read, write: if isAuthenticated();
    }

    match /course_qna/{id} {
      allow read, write: if isAuthenticated();
    }

    match /course_reviews/{id} {
      allow read, write: if isAuthenticated();
    }

    match /courses/{id} {
      allow read, write: if isAuthenticated();
    }

    match /enrollments/{id} {
      allow read, write: if isAuthenticated();
    }

    match /market_ebooks/{id} {
      allow read, write: if isAuthenticated();
    }

    match /payout_requests/{id} {
      allow read, write: if isAuthenticated();
    }

    match /purchases/{id} {
      allow read, write: if isAuthenticated();
    }

    match /quiz_results/{id} {
      allow read, write: if isAuthenticated();
    }

    match /quiz_submissions/{id} {
      allow read, write: if isAuthenticated();
    }

    match /quizzes/{id} {
      allow read, write: if isAuthenticated();
    }

    match /student_badges/{id} {
      allow read, write: if isAuthenticated();
    }

    match /transactions/{id} {
      allow read, write: if isAuthenticated();
    }

    match /user_history/{id} {
      allow read, write: if isAuthenticated();
    }

    match /users/{id} {
      allow read, write: if isAuthenticated();
    }

    match /user_wishlist/{id} {
      allow read, write: if isAuthenticated();
    }

    match /lessons/{id} {
      allow read, write: if isAuthenticated();
    }

    match /categories/{id} {
      allow read, write: if isAuthenticated();
    }

    match /progress/{id} {
      allow read, write: if isAuthenticated();
    }

    match /user_progress/{id} {
      allow read, write: if isAuthenticated();
    }

    match /certificates/{id} {
      allow read, write: if isAuthenticated();
    }

    match /downloads/{id} {
      allow read, write: if isAuthenticated();
    }

    match /ebooks/{id} {
      allow read, write: if isAuthenticated();
    }

    match /marketplace/{id} {
      allow read, write: if isAuthenticated();
    }

    match /wallets/{id} {
      allow read, write: if isAuthenticated();
    }

    match /walletTransactions/{id} {
      allow read, write: if isAuthenticated();
    }

    match /notifications/{id} {
      allow read, write: if isAuthenticated();
    }

    match /conversations/{id} {
      allow read, write: if isAuthenticated();
    }

    match /messages/{id} {
      allow read, write: if isAuthenticated();
    }

    match /communities/{id} {
      allow read, write: if isAuthenticated();
    }

    match /squads/{id} {
      allow read, write: if isAuthenticated();
    }

    match /sandboxProjects/{id} {
      allow read, write: if isAuthenticated();
    }

    match /templates/{id} {
      allow read, write: if isAuthenticated();
    }

    match /favorites/{id} {
      allow read, write: if isAuthenticated();
    }

    match /ambassadors/{id} {
      allow read, write: if isAuthenticated();
    }

    match /leaderboard/{id} {
      allow read, write: if isAuthenticated();
    }

    match /supportTickets/{id} {
      allow read, write: if isAuthenticated();
    }

    match /roles/{id} {
      allow read, write: if isAuthenticated();
    }

    match /settings/{id} {
      allow read, write: if isAuthenticated();
    }

    match /system_settings/{id} {
      allow read, write: if isAuthenticated();
    }

    match /statistics/{id} {
      allow read, write: if isAuthenticated();
    }

    match /reports/{id} {
      allow read, write: if isAuthenticated();
    }

    match /payments/{id} {
      allow read, write: if isAuthenticated();
    }

    match /licenses/{id} {
      allow read, write: if isAuthenticated();
    }

    match /market_data/{id} {
      allow read, write: if isAuthenticated();
    }

    match /market_orders/{id} {
      allow read, write: if isAuthenticated();
    }

    match /market_templates/{id} {
      allow read, write: if isAuthenticated();
    }

    match /squad_messages/{id} {
      allow read, write: if isAuthenticated();
    }

    match /support_tickets/{id} {
      allow read, write: if isAuthenticated();
    }

    match /courses/{courseId}/chapters/{chapterId} {
      allow read, write: if isAuthenticated();
    }
    match /courses/{courseId}/assignments/{assignmentId} {
      allow read, write: if isAuthenticated();
    }
    match /courses/{courseId}/quizzes/{quizId} {
      allow read, write: if isAuthenticated();
    }
    match /users/{userId}/notifications/{notifId} {
      allow read, write: if isAuthenticated();
    }
    match /users/{userId}/transactions/{txId} {
      allow read, write: if isAuthenticated();
    }
  }
}
